{
  "name": "goodraise",
  "private": true,
  "version": "1.0.0",
  "description": "Netlify deployment support for the GoodRaise campaign dashboard",
  "scripts": {
    "verify:auth": "node scripts/verify_netlify_auth.mjs",
    "reset:prelaunch:once": "node scripts/run_prelaunch_reset_once.mjs",
    "sync:google-sheets:once": "node scripts/run_google_sheets_sync_once.mjs",
    "sync:google-sheets:loop": "node scripts/run_google_sheets_sync_loop.mjs",
    "test:intelligence": "node --test tests/goodraise-intelligence.test.mjs",
    "test:multi-campaign": "node --test tests/multi-campaign-isolation.test.mjs",
    "test:local-backend": "node --test --test-concurrency=1 tests/local-backend-scope.test.mjs",
    "test:prelaunch-reset": "node --test tests/prelaunch-reset.test.mjs",
    "test:source-security": "node --test tests/source-security.test.mjs",
    "benchmark:intelligence": "node scripts/benchmark_intelligence.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.10",
    "pg": "^8.16.3"
  }
}
