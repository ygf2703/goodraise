# Local development runs React and the Node API at the same origin.
PORT=8767
HOST=127.0.0.1
GOODRAISE_MANAGER_EMAILS=[{"email":"manager@example.org","role":"platform_admin"}]
# GOODRAISE_ACCESS_CONTROL_JSON=work/config/dashboard-access.local.json
# GOODRAISE_DATA_DIR=work/data

# PostgreSQL is required for the relational ledger, manual contributions and
# ambassador registration imports. These defaults match compose.yaml. The app
# and migration runner use GOODRAISE_DATABASE_URL; local database tooling uses
# the second URL so it can never mistake a hosted database for the replaceable
# local target.
GOODRAISE_DATABASE_URL=postgresql://goodraise:goodraise-local-only@127.0.0.1:55432/goodraise
GOODRAISE_MIGRATION_DATABASE_URL=postgresql://goodraise:goodraise-local-only@127.0.0.1:55432/goodraise
# Migration 007 writes newly generated admin passwords here (0700 directory,
# 0600 files). Keep this outside public assets and source control.
# GOODRAISE_MIGRATION_CREDENTIALS_DIR=work/private/admin-credentials
GOODRAISE_LOCAL_DATABASE_URL=postgresql://goodraise:goodraise-local-only@127.0.0.1:55432/goodraise
GOODRAISE_LOCAL_DB_NAME=goodraise
GOODRAISE_LOCAL_DB_USER=goodraise
GOODRAISE_LOCAL_DB_PASSWORD=goodraise-local-only
GOODRAISE_LOCAL_DB_PORT=55432
# Hosted runtime should use a restricted pooled role; hosted migrations use the
# direct owner URL through GOODRAISE_MIGRATION_DATABASE_URL. Set the source URL
# only for a one-off backup/clone command. Use a direct, non-pooled hosted
# URL and do not save this production credential in a tracked file.
# GOODRAISE_SOURCE_DATABASE_URL=postgresql://username:password@host/database?sslmode=verify-full
GOODRAISE_RUN_RUNTIME_SCHEMA_MIGRATIONS=false
# GOODRAISE_INGEST_API_KEY=replace-with-a-long-random-secret

# Optional private build inputs; never included in the public frontend bundle.
# GOODRAISE_SOURCE_CSV=work/source.csv
# GOODRAISE_PRIZES_XLSX=work/prizes.xlsx
# GOODRAISE_PRIZES_CSV=work/prizes.csv

# Optional server-side integrations.
# OPENAI_API_KEY=
GOODRAISE_AI_MODEL=gpt-4.1-mini
# GOODRAISE_GOOGLE_SERVICE_ACCOUNT_JSON_PATH=work/config/goodraise-google-service-account.local.json
GOODRAISE_GOOGLE_SHEETS_SYNC_MINUTES=5
# Scheduled campaign jobs remain disabled in netlify.toml.
GOODRAISE_PRELAUNCH_RESET_ENABLED=false

# Campaign application email. Local development defaults to a JSON outbox in
# GOODRAISE_DATA_DIR. Hosted production requires Resend configuration.
# GOODRAISE_PUBLIC_URL=https://goodraise.example.org
# GOODRAISE_EMAIL_MODE=resend
# GOODRAISE_RESEND_API_KEY=re_...
# GOODRAISE_EMAIL_FROM=GoodRaise <applications@goodraise.example.org>
